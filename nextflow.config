params {
    // general parameters
    data_dir     = null   // host folder with the .czi files
    trainings_dir = null  // host folder containing the Trainings

    // cluster settings (only for the slurm_apptainer profile)
    images_dir        = null   // folder containing the .sif images
    slurm_gpu_queue   = null   // partition for the GPU steps (0 and 1)
    slurm_gpu_account = null   // account for the GPU steps
    slurm_cpu_queue   = null   // partition for the CPU-only step (2)
    slurm_cpu_account = null   // account for the CPU-only step

    // Step0 parameters
    czi_folder = "./data"
    exp_id = null
    sub_id = null
    rotation_angle = 0  

    // Step1 parameters
    which_network = "cellpose4"
    name_experiment = "experiment"
    training_to_load = "training_MB_251205/cellpose4training00/model_654269b8d2a64e4e87a3e82ca2e2cb40"
    flag_plot = false
    flag_gt = false
    positions = null
    name_series_list = null
    name_well_list = null
  

    // Step2 parameters
    cell_type = null
    imaging_frequency = null
    time_interval_discrepancy = null
    colony_size_limit = null
    generate_qc_report = true

    
    // Common parameters
    run_steps = "all"  // "step0", "step1", "step2", or "all"
    outdir = './results'
}

profiles {
    local {

        process.executor = 'local'

        conda.enabled = true
        conda.executable = '/home/tiziana/miniconda3/condabin/conda'

        process.env.PYTHONPATH = "${launchDir}:${launchDir}/src"

        process.cpus = { Runtime.getRuntime().availableProcessors() * 0.90 as int }
        process.memory = { 
            def mem = Runtime.getRuntime().maxMemory() 
            if (mem == null) return '80 GB' // Fallback 
            return "${(mem * 0.8 / (1024**3)) as int} GB" 
        }
        process.gpus = 1
        
        process {
            withName: STEP0_PROCESS_CZI {
                conda = '/home/tiziana/miniconda3/envs/envstep0'
                ext.python_bin = '/home/tiziana/miniconda3/envs/envstep0/bin/python3'
            }
            
            withName: 'STEP1_DETECTION|STEP2_AGGREGATION' {
                conda = '/home/tiziana/miniconda3/envs/cellposesam_inference'
                ext.python_bin = '/home/tiziana/miniconda3/envs/cellposesam_inference/bin/python3'
            }
        }
    }


    docker_local {
        process.executor = 'local'
        process.cpus = { Runtime.getRuntime().availableProcessors() * 0.90 as int }
        process.memory = { 
            def mem = Runtime.getRuntime().maxMemory()
            if (mem == null) return '80 GB'
            return "${(mem * 0.8 / (1024**3)) as int} GB" 
        }
        
        docker.enabled = true
        docker.runOptions = "--gpus all -v ${params.data_dir}:/app/data -v ${params.trainings_dir}:/Trainings"

        process {
            withName: STEP0_PROCESS_CZI {
                container = 'visiowell-step0:latest'
                ext.python_bin = 'export PYTHONPATH=/app:/app/src && python3'
            }
            
            withName: 'STEP1_DETECTION|STEP2_AGGREGATION' {
                container = 'visiowell-step1:latest'
                ext.python_bin = 'export PYTHONPATH=/app:/app/src && python3'
            }
        }
    }


    slurm_apptainer {
        process.executor = 'slurm'
        process.queue = "${params.slurm_gpu_queue}"
        process.clusterOptions = "--account=${params.slurm_gpu_account}"

        process.cpus = 8
        process.memory = '32 GB'
        process.time = '6h'            // per task (per step), not for the whole pipeline

        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = "-B ${params.data_dir}:/app/data -B ${params.trainings_dir}:/Trainings"

        process {
            withName: STEP0_PROCESS_CZI {
                clusterOptions = "--account=${params.slurm_gpu_account} --gres=gpu:1"
                containerOptions = '--nv'
                container = "${params.images_dir}/visiowell-step0_v1.0.0-cuda12.sif"
                ext.python_bin = 'export CUPY_CACHE_DIR=/tmp/cupy_cache PYTHONPATH=/app:/app/src && python3'
            }

            withName: STEP1_DETECTION {
                clusterOptions = "--account=${params.slurm_gpu_account} --gres=gpu:1"
                containerOptions = '--nv'
                time = '24h'
                container = "${params.images_dir}/visiowell-step1_v1.0.0-cuda12.sif"
                ext.python_bin = 'export PYTHONPATH=/app:/app/src && python3'
            }

            withName: STEP2_AGGREGATION {
                queue = "${params.slurm_cpu_queue}"
                clusterOptions = "--account=${params.slurm_cpu_account}"
                cpus = 2
                memory = '8 GB'
                time = '1h'
                container = "${params.images_dir}/visiowell-step1_v1.0.0-cuda12.sif"
                ext.python_bin = 'export PYTHONPATH=/app:/app/src && python3'
            }
        }
    }

}